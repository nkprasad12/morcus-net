{
  "plugins": [
    "stylelint-declaration-strict-value",
    "./src/web/v2/tools/max_file_lines.cjs"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["src/web/v2/**/*.css"],
      "rules": {
        "declaration-no-important": true,
        "scale-unlimited/declaration-strict-value": [
          ["z-index"],
          {
            "ignoreValues": ["auto"],
            "disableFix": true
          }
        ],
        "morcus/max-file-lines": 650
      }
    },
    {
      "files": ["src/web/v2/**/*.css"],
      "rules": {
        "selector-disallowed-list": ["/:root\\[data-theme/", "/\\[data-theme/"],
        "media-feature-name-disallowed-list": ["prefers-color-scheme"]
      }
    },
    {
      "files": ["src/web/v2/shell/**/*.css"],
      "rules": {
        "selector-disallowed-list": null,
        "media-feature-name-disallowed-list": null
      }
    }
  ]
}
